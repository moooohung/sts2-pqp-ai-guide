  "binding_contract": "DecisionId + authenticated net_id + typed Command + optional exact source/target/offer instance IDs; multi-selection spans reference the same decision's caller-owned selection sidecar.",
  "visibility": "Never encode seeds, RNG state, hidden draw order, unrevealed offers/rooms, hidden monster moves or private teammate hands. Known bits distinguish unknown from zero.",
  "scalar_limit": 16,
  "summary_groups": ["Combat", "Deck", "Map"],
  "summary_group_contract": "ObservationView::summary_group: Seat/Global excluded; live cards and combat choices in Combat, inventories/owned deck/offers in Deck, visible graph/bosses in Map; typed parameter/preview children inherit their parent.",
  "pile_group_contract": "RowsView.multiplicity is positive and weights both an indistinguishable Card group and its typed children. Full hands and all candidate-referenced cards remain materialized. Remaining publicly unique groups are available losslessly in ObservationView.streamed_piles for bounded-chunk weighted policy aggregation, with group-local handles above PILE_LOCAL_BASE and external Seat/PileSummary handles in the main observation. No legal bindings, numeric facts, draw order or RNG are discarded or exposed. V1 projection is absent for states the original V1 capacity rejected.",
  "card_preview_contract": "Every original PowerVar<T>, including named variables, has a CardPreview with displayed given-hook amount and instance base; received/Artifact hooks are not display hooks. Deck, offer and upgrade previews run without global hooks. Voltaic CalculatedChannels counts only its owner's successful Lightning channels in the public combat history, including evoked orbs.",
  "legacy_projection": {
    "baseline_revision": "2100b176022a904a40ccc89a6cfb0cc62caa83a2",
    "row_roles": ["Shared", "V2Only"],
    "contract": "RowsView.legacy_role excludes V2Only rows and descendants from the transferred branch; ObservationView.legacy is the exact V1 learned-input snapshot including original numeric lanes, ordering and edges. CandidatesView.legacy_source/legacy_target are in the legacy snapshot handle space, aligned by candidate slot. Legacy metadata is not learned. The V2 manifest must still pass refit rejection."
  }
}
